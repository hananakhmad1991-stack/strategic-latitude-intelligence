{
  "version": "2026-10-16",
  "provider": "World Bank World Development Indicators",
  "country": "IDN",
  "start_year": 1990,
  "max_year": "current",
  "api_base": "https://api.worldbank.org/v2/country/IDN/indicator/",
  "refresh_cadence": "Weekly Tuesday GitHub Actions 02:23 UTC; first run also on script/config push",
