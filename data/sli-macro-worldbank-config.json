    {
      "id": "annual_imports_goods_services",
      "code": "NE.IMP.GNFS.CD",
      "category": "Trade & External",
      "label": "Imports of goods and services",
      "unit": "current US$",
      "scale": 1
    },
    {
      "id": "annual_external_balance",
      "code": "NE.RSB.GNFS.CD",
      "category": "Trade & External",
      "label": "External balance goods and services",
      "unit": "current US$",
      "scale": 1
    },
    {
      "id": "annual_current_account",
      "code": "BN.CAB.XOKA.CD",
      "category": "Trade & External",
      "label": "Current account balance",
      "unit": "current US$",
