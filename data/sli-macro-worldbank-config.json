      "code": "NY.GDP.MKTP.KD.ZG",
      "category": "Growth & Production",
      "label": "Real GDP growth",
      "unit": "% annual",
      "scale": 1
    },
    {
      "id": "annual_gdp_usd",
      "code": "NY.GDP.MKTP.CD",
      "category": "Growth & Production",
      "label": "GDP current USD",
      "unit": "current US$",
      "scale": 1
    },
    {
      "id": "annual_gdp_per_capita_usd",
      "code": "NY.GDP.PCAP.CD",
      "category": "Growth & Production",
      "label": "GDP per capita",
      "unit": "current US$/person",
      "scale": 1
    },
    {
      "id": "annual_gdp_constant",
      "code": "NY.GDP.MKTP.KD",
      "category": "Growth & Production",
      "label": "GDP constant USD",
