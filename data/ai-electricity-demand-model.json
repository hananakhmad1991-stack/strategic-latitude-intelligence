  "formulas": {
    "existing_it_mw": "580 * base_it_fraction * (1+existing_growth_pct)^(year-2026)",
    "construction_it_mw": "construction_increment_it_mw * clamp((year-2026)/(construction_complete_year-2026),0,1)",
    "speculative_it_mw": "speculative_increment_it_mw * clamp((year-2029)/(speculative_complete_year-2029),0,1)",
    "annual_gwh": "(existing_it_mw + construction_it_mw + speculative_it_mw) * utilization * pue * 8.76",
    "annual_mtco2": "annual_gwh * (1-clean_fraction) * grid_factor / 1000",
    "grid_peak_mw": "total_it_mw*pue",
