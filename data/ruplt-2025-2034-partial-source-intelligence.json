    {
      "id": "additional_large_industry",
      "pdf_pages": [
        5,
        46,
        61
      ],
      "finding": "Additional electricity demand for priority industrial consumers may require ESDM-approved plan amendment; uncommitted large customer loads separated by confidence",
      "investor_implication": "Do not assume an AI campus announcement automatically receives reserved firm power."
    },
    {
      "id": "customer_confidence",
      "pdf_pages": [
        46,
        53
      ],
      "finding": "Confidence levels for large KTT customers based on PJBTL, paid connection charges, construction, probing and MoU; base scenario emphasizes higher-confidence projects",
      "investor_implication": "Classify AI data-center grid demand by evidence of signed contract, paid connection charge and substations under construction."
    },
    {
      "id": "N_minus_1",
      "pdf_pages": [
        86,
        89,
        90
      ],
      "finding": "N-1 contingency planning for transmission and substations, including static/dynamic security",
      "investor_implication": "A multi-GPU site needs firm contingency analysis, not just regional MVA."
    },
    {
      "id": "grid_COD_threshold",
      "pdf_pages": [
        90
      ],
      "finding": "70–80% GI load criterion for COD of transformer reinforcement typically used, subject to evaluation and N-1 exceptions",
      "investor_implication": "Data center MW compared with verified individual GI load headroom; no observed local saturation inferred."
    },
    {
      "id": "energy_reliability_LOLP",
      "pdf_pages": [
        61
      ],
      "finding": "Generation adequacy benchmark LOLP below 0.274%",
      "investor_implication": "LOLP refers generation adequacy, not site-level uptime SLA."
    },
    {
      "id": "renewable_procurement",
      "pdf_pages": [
        54,
        55
      ],
      "finding": "Renewable energy certificates (REC) and verification/tracking are described separately from physical power supply",
      "investor_implication": "Contractual clean energy claims do not by themselves verify hourly renewable matching."
    },
    {
      "id": "floating_solar_opportunity",
      "pdf_pages": [
        82,
        83
      ],
      "finding": "109 indicative reservoir floating PV entries from Table 2.2, not operating PV plants",
      "investor_implication": "Potential power supply/cooling tradeoffs require water, grid connection and feasibility diligence."
    },
    {
      "id": "grid_service_quality",
      "pdf_pages": [
        99
      ],
      "finding": "Distribution planning mentions voltage 90–105% of nominal and frequency 49.5–50.5 Hz, plus harmonic limits",
